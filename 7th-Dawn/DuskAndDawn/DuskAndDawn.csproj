<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 8 (LTS): builds with the .NET 8, 9 or 10 SDK, and runs on any newer runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Extended" Version="6.1.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
  </ItemGroup>

  <!-- A "Download ZIP" from GitHub leaves every file marked as downloaded from the internet
       (Windows: "this file came from another computer and might be blocked"). On Windows,
       clear that mark from the project's files once, on the first build. Never fails the build. -->
  <Target Name="UnblockDownloadedFiles" BeforeTargets="PrepareForBuild;_RestoreMGCBTool"
          Condition="'$(OS)' == 'Windows_NT' And !Exists('$(IntermediateOutputPath)unblocked.marker')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -LiteralPath '$(MSBuildProjectDirectory.Replace(&quot;'&quot;, &quot;''&quot;))' -Recurse -File | Unblock-File&quot;"
          IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" />
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <Touch Files="$(IntermediateOutputPath)unblocked.marker" AlwaysCreate="true" ContinueOnError="true" />
  </Target>

  <!-- The content builder (MGCB) is a .NET local tool (.config/dotnet-tools.json), not a NuGet
       package, so a new machine downloads it (about 220 MB) during its first build. MonoGame's
       own step ignores a failed download, and the build then dies later with a bare
       "dotnet mgcb ... exited with code 1". This tries the download again, and if it still
       fails, stops with an error that says what went wrong. It only runs when MonoGame's step
       hasn't succeeded yet (no marker file), so a normal build doesn't pay for it. -->
  <Target Name="EnsureMgcbTool" BeforeTargets="RunContentBuilder" Condition="!Exists('$(IntermediateOutputPath)mgcb.tool.restore')">
    <Exec Command="&quot;$(DotnetCommand)&quot; tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_MgcbToolRestoreExit" />
    </Exec>
    <Exec Condition="'$(_MgcbToolRestoreExit)' != '0'" Command="&quot;$(DotnetCommand)&quot; tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_MgcbToolRestoreExit" />
    </Exec>
    <Exec Condition="'$(_MgcbToolRestoreExit)' != '0'" Command="&quot;$(DotnetCommand)&quot; tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_MgcbToolRestoreExit" />
    </Exec>
    <Error Condition="'$(_MgcbToolRestoreExit)' != '0'"
           Text="Couldn't download the MonoGame content builder (MGCB, about 220 MB) that builds the game's art and fonts. Check your internet connection, then build again - or run &quot;dotnet tool restore&quot; in the 7th-Dawn/DuskAndDawn folder. See README.md." />
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <Touch Files="$(IntermediateOutputPath)mgcb.tool.restore" AlwaysCreate="true" />
  </Target>
</Project>