<?xml version="1.0" encoding="utf-8"?>
<!-- Restore this game's packages (and the MGCB tool) from nuget.org only, whatever other
     package sources a machine has set up - a stale, offline or private feed elsewhere in a
     computer's NuGet settings can otherwise fail the restore. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
